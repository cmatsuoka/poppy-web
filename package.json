{
  "name": "poppy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser recreation of a vintage preset rhythm unit, powered by libpoppy",
  "license": "MIT",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev": "vite",
    "dev:secure": "vite --host --mode secure",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "test:glue": "bash scripts/test-glue.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
